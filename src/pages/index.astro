---
import catalog from '../data/gunpla.json';
import { listImages } from '../lib/database';

const imageRecords = await listImages().catch(() => []);
const altTextById = new Map(imageRecords.map((record) => [record.gunpla_id, record.alt_text]));
const gunplaDatabase = catalog.map((item) => ({
    ...item,
    imageAlt: altTextById.get(item.id) || `${item.name} Master Grade model kit`,
}));
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="A searchable Master Grade Gundam Wing Gunpla archive built with Astro.">
    <title>Gundam Wing MG Gunpla Archive | Master Grade Catalog</title>
    <!-- Tailwind CSS CDN -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        mecha: {
                            900: '#0b0f19',
                            800: '#111827',
                            700: '#1f293d',
                            600: '#374151',
                        },
                        cyber: {
                            cyan: '#06b6d4',
                            blue: '#3b82f6',
                            amber: '#f59e0b',
                            purple: '#8b5cf6',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .font-mono { font-family: 'JetBrains Mono', monospace; }
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #0b0f19; }
        ::-webkit-scrollbar-thumb { background: #374151; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #06b6d4; }
        .glow-cyan { box-shadow: 0 0 20px rgba(6, 182, 212, 0.15); }
        .glow-amber { box-shadow: 0 0 20px rgba(245, 158, 11, 0.15); }
    </style>
</head>
<body class="bg-mecha-900 text-gray-100 min-h-screen flex flex-col justify-between selection:bg-cyber-cyan selection:text-mecha-900">

    <!-- Header Component (Header.astro) -->
    <header class="bg-mecha-800/80 backdrop-blur-md border-b border-gray-800 sticky top-z-50 z-40 sticky top-0">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="bg-gradient-to-br from-cyber-cyan to-cyber-blue p-2.5 rounded-xl text-mecha-900 font-bold shadow-lg glow-cyan">
                    <i class="fa-solid fa-robot text-xl"></i>
                </div>
                <div>
                    <span class="text-xs font-mono uppercase tracking-widest text-cyber-cyan font-semibold block">Astro Web Service</span>
                    <span class="text-lg sm:text-xl font-extrabold tracking-tight text-white">OPERATION: METEOR MG ARCHIVE</span>
                </div>
            </div>
            <div class="hidden md:flex items-center space-x-6 text-sm font-medium text-gray-300">
                <span class="flex items-center gap-1.5"><i class="fa-solid fa-cube text-cyber-cyan"></i> Scale: 1/100</span>
                <span class="flex items-center gap-1.5"><i class="fa-solid fa-shield-halved text-cyber-amber"></i> Total Kits: 30</span>
                <span class="px-3 py-1 bg-cyber-cyan/10 text-cyber-cyan border border-cyber-cyan/30 rounded-full font-mono text-xs">Astro SSR + S3</span>
                <a href="/admin" class="text-xs font-mono text-gray-400 hover:text-cyber-cyan" rel="nofollow"><i class="fa-solid fa-lock mr-1"></i> Admin</a>
            </div>
        </div>
    </header>

    <!-- Hero Section Component (Hero.astro) -->
    <section class="relative bg-gradient-to-b from-mecha-800 via-mecha-900 to-mecha-900 border-b border-gray-800 py-16 lg:py-24 overflow-hidden">
        <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#06b6d4_1px,transparent_1px)] [background-size:16px_16px] pointer-events-none"></div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-cyber-blue/10 border border-cyber-blue/30 text-cyber-cyan text-xs font-mono mb-6">
                <i class="fa-solid fa-meteor animate-pulse"></i> Gundam Wing • Master Grade (MG) 1/100 Archive
            </div>
            <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white mb-6 uppercase">
                Defenders of the <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyber-cyan via-cyber-blue to-cyber-amber">After Colony</span>
            </h1>
            <p class="max-w-3xl mx-auto text-gray-400 text-base sm:text-lg mb-10 leading-relaxed">
                Explore the complete collection of 30 Master Grade (MG) Gunpla from Mobile Suit Gundam Wing and Endless Waltz. Featuring standard retail releases alongside elite Premium Bandai limited editions.
            </p>

            <!-- Quick Stats Bar -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto text-left">
                <div class="bg-mecha-800/80 border border-gray-700/60 p-4 rounded-xl backdrop-blur-sm">
                    <span class="text-xs font-mono text-gray-400 block mb-1">RETAIL RELEASES</span>
                    <span class="text-2xl font-bold font-mono text-cyber-cyan">18 Kits</span>
                </div>
                <div class="bg-mecha-800/80 border border-gray-700/60 p-4 rounded-xl backdrop-blur-sm">
                    <span class="text-xs font-mono text-gray-400 block mb-1">PREMIUM P-BANDAI</span>
                    <span class="text-2xl font-bold font-mono text-cyber-amber">12 Kits</span>
                </div>
                <div class="bg-mecha-800/80 border border-gray-700/60 p-4 rounded-xl backdrop-blur-sm">
                    <span class="text-xs font-mono text-gray-400 block mb-1">FACTIONS</span>
                    <span class="text-2xl font-bold font-mono text-cyber-blue">Operation Meteor / OZ</span>
                </div>
                <div class="bg-mecha-800/80 border border-gray-700/60 p-4 rounded-xl backdrop-blur-sm">
                    <span class="text-xs font-mono text-gray-400 block mb-1">GRADE STANDARD</span>
                    <span class="text-2xl font-bold font-mono text-white">Master Grade 1/100</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Content & Filter Component (CatalogSection.astro) -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 flex-grow w-full">
        
        <!-- Controls: Search & Filters -->
        <div class="bg-mecha-800/90 border border-gray-800 p-6 rounded-2xl mb-10 shadow-xl backdrop-blur-md space-y-4">
            <div class="flex flex-col lg:flex-row gap-4 items-center justify-between">
                <!-- Search Input -->
                <div class="relative w-full lg:w-96">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none text-gray-400">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>
                    <input type="text" id="searchInput" oninput="filterGunpla()" placeholder="Search by mobile suit name or pilot..." 
                        class="w-full pl-11 pr-4 py-3 bg-mecha-900 border border-gray-700 rounded-xl text-white placeholder-gray-500 text-sm focus:outline-none focus:border-cyber-cyan focus:ring-1 focus:ring-cyber-cyan transition-all">
                </div>

                <!-- Grade Type Filters -->
                <div class="flex flex-wrap gap-2 w-full lg:w-auto">
                    <button onclick="setFilterType('all')" id="filter-type-all" class="filter-type-btn px-4 py-2 rounded-xl text-xs font-mono font-semibold transition-all bg-cyber-cyan text-mecha-900 shadow-lg">
                        All (30)
                    </button>
                    <button onclick="setFilterType('Retail')" id="filter-type-Retail" class="filter-type-btn px-4 py-2 rounded-xl text-xs font-mono font-semibold transition-all bg-mecha-900 text-gray-300 border border-gray-700 hover:border-cyber-cyan">
                        Common / Retail (18)
                    </button>
                    <button onclick="setFilterType('P-Bandai')" id="filter-type-P-Bandai" class="filter-type-btn px-4 py-2 rounded-xl text-xs font-mono font-semibold transition-all bg-mecha-900 text-gray-300 border border-gray-700 hover:border-cyber-amber">
                        Premium / P-Bandai (12)
                    </button>
                </div>
            </div>

            <!-- Faction Filters -->
            <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-gray-700/60">
                <span class="text-xs font-mono text-gray-400 mr-2"><i class="fa-solid fa-filter mr-1"></i> FACTION:</span>
                <button onclick="setFaction('all')" id="faction-all" class="faction-btn px-3 py-1.5 rounded-lg text-xs font-mono bg-cyber-blue text-white shadow">
                    All Factions
                </button>
                <button onclick="setFaction('Operation Meteor')" id="faction-Operation Meteor" class="faction-btn px-3 py-1.5 rounded-lg text-xs font-mono bg-mecha-900 text-gray-300 border border-gray-700 hover:text-white">
                    Operation Meteor (Gundams)
                </button>
                <button onclick="setFaction('OZ')" id="faction-OZ" class="faction-btn px-3 py-1.5 rounded-lg text-xs font-mono bg-mecha-900 text-gray-300 border border-gray-700 hover:text-white">
                    OZ / United Nations
                </button>
                <button onclick="setFaction('White Fang')" id="faction-White Fang" class="faction-btn px-3 py-1.5 rounded-lg text-xs font-mono bg-mecha-900 text-gray-300 border border-gray-700 hover:text-white">
                    White Fang
                </button>
            </div>
        </div>

        <!-- Gunpla Grid Container -->
        <div id="gunplaGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Rendered dynamically via JavaScript dataset -->
        </div>

        <!-- Empty State -->
        <div id="emptyState" class="hidden text-center py-20 bg-mecha-800/50 rounded-2xl border border-gray-800 mt-6">
            <div class="text-gray-500 text-5xl mb-3"><i class="fa-solid fa-satellite-dish"></i></div>
            <h3 class="text-lg font-bold text-white">No Gunpla found matching parameters</h3>
            <p class="text-gray-400 text-sm mt-1">Try resetting your search query or filters.</p>
        </div>
    </main>

    <!-- Detail Modal Component (GunplaModal.astro) -->
    <div id="detailModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md hidden">
        <div class="bg-mecha-800 border border-gray-700 rounded-2xl max-w-2xl w-full overflow-hidden shadow-2xl transform transition-all scale-95 opacity-0 duration-300" id="modalContainer">
            <div class="bg-gradient-to-r from-mecha-700 to-mecha-800 px-6 py-4 border-b border-gray-700 flex justify-between items-center">
                <div class="flex items-center gap-3">
                    <span id="modalBadge" class="px-2.5 py-1 rounded text-xs font-mono font-bold">TYPE</span>
                    <h3 id="modalTitle" class="text-lg font-bold text-white font-mono">Mobile Suit Name</h3>
                </div>
                <button onclick="closeModal()" class="text-gray-400 hover:text-white p-2 rounded-lg transition-colors">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <div class="p-6 space-y-5 max-h-[75vh] overflow-y-auto">
                <div class="relative aspect-video overflow-hidden rounded-xl border border-gray-700 bg-mecha-900">
                    <span class="absolute inset-0 grid place-items-center text-sm font-mono text-gray-600">No catalog image</span>
                    <img id="modalImage" src="" alt="" class="relative h-full w-full object-cover" onerror="this.hidden=true">
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="bg-mecha-900 p-4 rounded-xl border border-gray-700/50">
                        <span class="text-xs font-mono text-gray-400 block mb-1">PILOT / AFFILIATION</span>
                        <span id="modalPilot" class="text-sm font-semibold text-cyber-cyan">Heero Yuy</span>
                    </div>
                    <div class="bg-mecha-900 p-4 rounded-xl border border-gray-700/50">
                        <span class="text-xs font-mono text-gray-400 block mb-1">RELEASE YEAR & PRICE</span>
                        <span id="modalRelease" class="text-sm font-semibold text-cyber-amber">2010 • ¥4,500</span>
                    </div>
                </div>
                <div>
                    <h4 class="text-xs uppercase font-mono tracking-wider text-gray-400 mb-1.5">Lore & Design Specifications</h4>
                    <p id="modalLore" class="text-gray-300 text-sm leading-relaxed">Lore description goes here.</p>
                </div>
                <div class="bg-mecha-900 p-4 rounded-xl border border-gray-700/50 space-y-2">
                    <h4 class="text-xs uppercase font-mono tracking-wider text-cyber-cyan mb-2"><i class="fa-solid fa-crosshairs mr-1"></i> Standard Armament & Loadout</h4>
                    <p id="modalArmament" class="text-sm font-medium text-gray-200">Buster Rifle, Beam Saber, Shield</p>
                </div>
            </div>
            <div class="bg-mecha-900 px-6 py-4 border-t border-gray-700 flex justify-end">
                <button onclick="closeModal()" class="px-5 py-2.5 bg-cyber-cyan hover:bg-cyber-blue text-mecha-900 font-bold text-xs font-mono rounded-xl transition-colors">
                    Close Archive
                </button>
            </div>
        </div>
    </div>

    <!-- Footer Component (Footer.astro) -->
    <footer class="bg-mecha-800 border-t border-gray-800 py-8 text-center text-xs text-gray-400 mt-16 font-mono">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-2">
            <p>MOBILE SUIT GUNDAM WING • MASTER GRADE (MG) ARCHIVE DATABASE &copy; 2026</p>
            <p class="text-gray-500">Astro server-rendered architecture with private object storage. All Gunpla models and trademarks belong to Bandai Spirits & Sunrise.</p>
        </div>
    </footer>

    <!-- Application Logic; catalog data is supplied from src/data/gunpla.json -->
    <script is:inline define:vars={{ gunplaDatabase }}>
        /* 
          Astro Page Script: Complete Dataset of 30 Gundam Wing Master Grade (MG) Kits
          Includes both common retail releases and premium P-Bandai / limited editions.
        */


        let activeTypeFilter = 'all';
        let activeFactionFilter = 'all';

        function escapeHtml(value) {
            return String(value).replace(/[&<>"']/g, character => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;'
            })[character]);
        }

        // Initialize App on DOM Load
        document.addEventListener('DOMContentLoaded', () => {
            renderGunplaGrid(gunplaDatabase);
        });

        // Render Gunpla Grid Cards
        function renderGunplaGrid(items) {
            const grid = document.getElementById('gunplaGrid');
            const emptyState = document.getElementById('emptyState');

            if (items.length === 0) {
                grid.innerHTML = '';
                emptyState.classList.remove('hidden');
                return;
            }

            emptyState.classList.add('hidden');
            grid.innerHTML = items.map(item => `
                <div class="bg-mecha-800 border border-gray-700/80 rounded-2xl p-6 shadow-xl hover:border-cyber-cyan/60 transition-all duration-300 flex flex-col justify-between group">
                    <div>
                        <div class="relative -mx-6 -mt-6 mb-5 aspect-video overflow-hidden border-b border-gray-700 bg-mecha-900">
                            <span class="absolute inset-0 grid place-items-center px-4 text-center text-xs font-mono text-gray-600">Image can be added by the archive administrator</span>
                            <img src="/api/images/${item.id}" alt="${escapeHtml(item.imageAlt)}" class="relative h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" loading="lazy" decoding="async" onerror="this.hidden=true">
                        </div>
                        <div class="flex items-center justify-between gap-2 mb-4">
                            <span class="px-2.5 py-1 rounded text-xs font-mono font-bold ${
                                item.type === 'Retail' 
                                    ? 'bg-cyber-cyan/10 text-cyber-cyan border border-cyber-cyan/30' 
                                    : 'bg-cyber-amber/10 text-cyber-amber border border-cyber-amber/30'
                            }">${item.type}</span>
                            <span class="text-xs font-mono text-gray-400 bg-mecha-900 px-2.5 py-1 rounded border border-gray-800">
                                <i class="fa-solid fa-cube text-cyber-blue mr-1"></i> ${item.scale}
                            </span>
                        </div>
                        <span class="text-xs font-mono text-cyber-blue uppercase tracking-wider block mb-1">${item.series} • ${item.faction}</span>
                        <h3 class="text-lg font-bold text-white group-hover:text-cyber-cyan transition-colors mb-2">${item.name}</h3>
                        <p class="text-xs text-gray-400 mb-4 line-clamp-2">${item.lore}</p>
                    </div>
                    <div>
                        <div class="bg-mecha-900 p-3 rounded-xl border border-gray-800/80 mb-4 flex items-center justify-between text-xs font-mono">
                            <span class="text-gray-400">Pilot: <strong class="text-gray-200">${item.pilot}</strong></span>
                            <span class="text-cyber-amber font-bold">${item.release} (${item.price})</span>
                        </div>
                        <button onclick="openModal('${item.id}')" class="w-full py-2.5 bg-mecha-700 hover:bg-cyber-cyan hover:text-mecha-900 text-gray-200 text-xs font-mono font-bold rounded-xl transition-all flex items-center justify-center gap-2">
                            <i class="fa-solid fa-microchip"></i> Access Specifications
                        </button>
                    </div>
                </div>
            `).join('');
        }

        // Set Grade Type Filter
        function setFilterType(type) {
            activeTypeFilter = type;
            document.querySelectorAll('.filter-type-btn').forEach(btn => {
                btn.className = "filter-type-btn px-4 py-2 rounded-xl text-xs font-mono font-semibold transition-all bg-mecha-900 text-gray-300 border border-gray-700 hover:border-gray-500";
            });
            const activeBtn = document.getElementById(`filter-type-${type}`);
            if (activeBtn) {
                activeBtn.className = type === 'P-Bandai' 
                    ? "filter-type-btn px-4 py-2 rounded-xl text-xs font-mono font-semibold transition-all bg-cyber-amber text-mecha-900 shadow-lg"
                    : "filter-type-btn px-4 py-2 rounded-xl text-xs font-mono font-semibold transition-all bg-cyber-cyan text-mecha-900 shadow-lg";
            }
            filterGunpla();
        }

        // Set Faction Filter
        function setFaction(faction) {
            activeFactionFilter = faction;
            document.querySelectorAll('.faction-btn').forEach(btn => {
                btn.className = "faction-btn px-3 py-1.5 rounded-lg text-xs font-mono bg-mecha-900 text-gray-300 border border-gray-700 hover:text-white";
            });
            const activeBtn = document.getElementById(`faction-${faction}`);
            if (activeBtn) {
                activeBtn.className = "faction-btn px-3 py-1.5 rounded-lg text-xs font-mono bg-cyber-blue text-white shadow";
            }
            filterGunpla();
        }

        // Filter Function for Search, Type, and Faction
        function filterGunpla() {
            const query = document.getElementById('searchInput').value.toLowerCase().trim();

            const filtered = gunplaDatabase.filter(item => {
                const matchesType = activeTypeFilter === 'all' || item.type === activeTypeFilter;
                const matchesFaction = activeFactionFilter === 'all' || item.faction === activeFactionFilter;
                const matchesSearch = item.name.toLowerCase().includes(query) || 
                                      item.pilot.toLowerCase().includes(query) || 
                                      item.series.toLowerCase().includes(query) ||
                                      item.faction.toLowerCase().includes(query);
                return matchesType && matchesFaction && matchesSearch;
            });

            renderGunplaGrid(filtered);
        }

        // Modal Open Function
        function openModal(id) {
            const item = gunplaDatabase.find(i => i.id === id);
            if (!item) return;

            const badge = document.getElementById('modalBadge');
            badge.innerText = item.type;
            badge.className = item.type === 'Retail' 
                ? "px-2.5 py-1 rounded text-xs font-mono font-bold bg-cyber-cyan/10 text-cyber-cyan border border-cyber-cyan/30"
                : "px-2.5 py-1 rounded text-xs font-mono font-bold bg-cyber-amber/10 text-cyber-amber border border-cyber-amber/30";

            document.getElementById('modalTitle').innerText = item.name;
            document.getElementById('modalPilot').innerText = `${item.pilot} (${item.faction})`;
            document.getElementById('modalRelease').innerText = `${item.release} • ${item.price} (${item.scale})`;
            document.getElementById('modalLore').innerText = item.lore;
            document.getElementById('modalArmament').innerText = item.armament;
            const modalImage = document.getElementById('modalImage');
            modalImage.hidden = false;
            modalImage.src = `/api/images/${item.id}`;
            modalImage.alt = item.imageAlt;

            const modal = document.getElementById('detailModal');
            const container = document.getElementById('modalContainer');
            modal.classList.remove('hidden');

            setTimeout(() => {
                container.classList.remove('scale-95', 'opacity-0');
                container.classList.add('scale-100', 'opacity-100');
            }, 10);
        }

        // Modal Close Function
        function closeModal() {
            const modal = document.getElementById('detailModal');
            const container = document.getElementById('modalContainer');

            container.classList.remove('scale-100', 'opacity-100');
            container.classList.add('scale-95', 'opacity-0');

            setTimeout(() => {
                modal.classList.add('hidden');
            }, 200);
        }

        // Close modal when clicking background overlay
        window.onclick = function(event) {
            const modal = document.getElementById('detailModal');
            if (event.target === modal) {
                closeModal();
            }
        }
    </script>
</body>
</html>
