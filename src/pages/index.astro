---
import "../styles/app.css";
import seed from "../data/gunpla.json";
import { listGunpla, listImages } from "../lib/database";

let degraded = false;
const fallback = seed.map((item) => ({ ...item, tags: [], notes: "", created_at: "", updated_at: "" }));
const records = await listGunpla().catch((error) => { console.error("Catalog database unavailable", error); degraded = true; return fallback; });
const images = await listImages().catch((error) => { console.error("Gallery database unavailable", error); degraded = true; return []; });
const byGunpla = new Map<string, typeof images>();
for (const image of images) byGunpla.set(image.gunpla_id, [...(byGunpla.get(image.gunpla_id) || []), image]);
const catalog = records.map((record) => ({ ...record, images: byGunpla.get(record.id) || [] }));
const retail = records.filter((item) => item.type.toLowerCase().includes("retail")).length;
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="A searchable Gunpla knowledge base with private S3 galleries."><title>Gunpla Archive</title></head>
<body>
  <header class="topbar"><div class="shell topbar-inner"><a class="brand" href="/"><span class="brand-mark">MG</span><span><span class="eyebrow">Personal collection</span><strong>Gunpla Archive</strong></span></a><nav class="nav-actions"><span class="badge optional">Astro + NEO DB + S3</span><a class="button ghost" href="/admin">Admin</a></nav></div></header>
  <section class="hero"><div class="shell"><p class="eyebrow">Operation Meteor knowledge base</p><h1>Every build has a story worth preserving.</h1><p>Explore kit specifications, pilots, armaments, notes, tags, and image galleries. Administrators can manage the complete collection without editing source code.</p><div class="stats"><div class="stat"><span>Total records</span><strong>{records.length}</strong></div><div class="stat"><span>Retail releases</span><strong>{retail}</strong></div><div class="stat"><span>Gallery images</span><strong>{images.length}</strong></div></div></div></section>
  <main class="shell catalog">
    {degraded && <p class="notice">The live database or storage index is temporarily unavailable. Seed catalog data is shown without galleries.</p>}
    <section class="panel toolbar" aria-label="Catalog filters"><div class="field grow"><label for="search">Search the archive</label><input class="input" id="search" type="search" placeholder="Name, pilot, series, tag…"></div><div class="field"><label for="type">Release type</label><select class="select" id="type"><option value="">All types</option></select></div><div class="field"><label for="faction">Faction</label><select class="select" id="faction"><option value="">All factions</option></select></div></section>
    <p id="resultCount" class="eyebrow" aria-live="polite"></p><section id="grid" class="grid" aria-label="Gunpla catalog"></section><div id="empty" class="panel empty" hidden>No Gunpla matches these filters.</div>
  </main>
  <dialog id="detail"><div class="dialog-head"><div><p class="eyebrow" id="detailType"></p><h2 id="detailTitle"></h2></div><button class="close" type="button" data-close aria-label="Close">×</button></div><div class="dialog-body"><div class="gallery-main"><span class="placeholder" id="detailPlaceholder">No gallery image yet</span><img id="detailImage" alt="" hidden></div><div class="thumbs" id="thumbs" aria-label="Gallery thumbnails"></div><div class="detail-grid"><div class="detail"><span>Pilot / faction</span><strong id="detailPilot"></strong></div><div class="detail"><span>Release / price / scale</span><strong id="detailRelease"></strong></div></div><div class="badges" id="detailTags" style="margin-top:1rem"></div><h3>Lore</h3><p class="copy" id="detailLore"></p><h3>Armament</h3><p class="copy" id="detailArmament"></p><section id="notesSection"><h3>Builder notes</h3><p class="copy" id="detailNotes"></p></section></div></dialog>
  <footer class="footer"><div class="shell">Gunpla Archive · private object storage is served through authenticated application credentials · v2.0.0</div></footer>
  <script is:inline define:vars={{ catalog }}>
    const esc=(v)=>String(v??"").replace(/[&<>"']/g,(c)=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"})[c]);
    const grid=document.querySelector("#grid"),empty=document.querySelector("#empty"),count=document.querySelector("#resultCount"),search=document.querySelector("#search"),type=document.querySelector("#type"),faction=document.querySelector("#faction"),dialog=document.querySelector("#detail");
    const unique=(key)=>[...new Set(catalog.map((item)=>item[key]).filter(Boolean))].sort();
    for(const value of unique("type")) type.insertAdjacentHTML("beforeend",`<option>${esc(value)}</option>`);
    for(const value of unique("faction")) faction.insertAdjacentHTML("beforeend",`<option>${esc(value)}</option>`);
    function render(){const q=search.value.trim().toLowerCase();const filtered=catalog.filter((item)=>(!type.value||item.type===type.value)&&(!faction.value||item.faction===faction.value)&&[item.name,item.pilot,item.series,item.faction,item.lore,...item.tags].join(" ").toLowerCase().includes(q));count.textContent=`${filtered.length} of ${catalog.length} records`;empty.hidden=filtered.length>0;grid.innerHTML=filtered.map((item)=>{const cover=item.images[0];return `<article class="card"><div class="card-image"><span class="placeholder">No gallery image yet</span>${cover?`<img loading="lazy" decoding="async" src="/api/images/${encodeURIComponent(cover.image_id)}" alt="${esc(cover.alt_text)}">`:""}<span class="count">${item.images.length}/7 images</span></div><div class="card-body"><div class="badges"><span class="badge${item.type.toLowerCase().includes("bandai")?" amber":""}">${esc(item.type)}</span><span class="badge">${esc(item.scale)}</span></div><h2>${esc(item.name)}</h2><p class="summary">${esc(item.lore)}</p><div class="meta"><span>${esc(item.pilot)}</span><span>${esc(item.release)}</span></div><button class="button" style="width:100%;margin-top:.8rem" type="button" data-open="${esc(item.id)}">View details</button></div></article>`}).join("");}
    function open(id){const item=catalog.find((value)=>value.id===id);if(!item)return;document.querySelector("#detailType").textContent=`${item.type} · ${item.series}`;document.querySelector("#detailTitle").textContent=item.name;document.querySelector("#detailPilot").textContent=`${item.pilot} · ${item.faction}`;document.querySelector("#detailRelease").textContent=`${item.release} · ${item.price} · ${item.scale}`;document.querySelector("#detailLore").textContent=item.lore;document.querySelector("#detailArmament").textContent=item.armament;document.querySelector("#detailNotes").textContent=item.notes||"No builder notes yet.";document.querySelector("#detailTags").innerHTML=item.tags.map((tag)=>`<span class="badge">${esc(tag)}</span>`).join("");const thumbs=document.querySelector("#thumbs"),main=document.querySelector("#detailImage"),placeholder=document.querySelector("#detailPlaceholder");function choose(image,index){main.src=`/api/images/${encodeURIComponent(image.image_id)}`;main.alt=image.alt_text;main.hidden=false;placeholder.hidden=true;thumbs.querySelectorAll(".thumb").forEach((node,i)=>node.classList.toggle("active",i===index));}thumbs.innerHTML=item.images.map((image,index)=>`<button type="button" class="thumb${index===0?" active":""}" data-image="${index}" aria-label="Show image ${index+1}"><img src="/api/images/${encodeURIComponent(image.image_id)}" alt="${esc(image.alt_text)}"></button>`).join("");if(item.images[0])choose(item.images[0],0);else{main.hidden=true;main.removeAttribute("src");placeholder.hidden=false}thumbs.onclick=(event)=>{const button=event.target.closest("[data-image]");if(button)choose(item.images[Number(button.dataset.image)],Number(button.dataset.image))};dialog.showModal();}
    [search,type,faction].forEach((node)=>node.addEventListener(node===search?"input":"change",render));grid.addEventListener("click",(event)=>{const button=event.target.closest("[data-open]");if(button)open(button.dataset.open)});dialog.querySelector("[data-close]").addEventListener("click",()=>dialog.close());dialog.addEventListener("click",(event)=>{if(event.target===dialog)dialog.close()});render();
  </script>
</body></html>
