# Local Docker Compose values. Change these before sharing the environment.
POSTGRES_DB=gunpla
POSTGRES_USER=gunpla
POSTGRES_PASSWORD=change-this-database-password
MINIO_ROOT_USER=gunpla-local
MINIO_ROOT_PASSWORD=change-this-storage-password

# Generate with: npm run hash-password -- "your-long-admin-password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='scrypt$replace-with-generated-value'

# Use a random value containing at least 32 characters.
SESSION_SECRET=replace-with-a-long-random-session-secret

# Runtime settings used by NEO App or a manual local run.
PORT=3000
DATABASE_URL=postgresql://gunpla:change-this-database-password@localhost:5432/gunpla
DATABASE_AUTO_MIGRATE=true
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=gunpla-assets
S3_PREFIX=gunpla
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=gunpla-local
S3_SECRET_ACCESS_KEY=change-this-storage-password
MAX_IMAGE_BYTES=5242880
