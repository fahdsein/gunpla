# NEO normally injects PORT. Do not add PORT manually unless the service requires it.
NODE_ENV=production
DATABASE_AUTO_MIGRATE=true
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_SIZE=5

# Object Storage. Copy these values from the attached NEO storage resource.
S3_ENDPOINT=https://replace-with-neo-object-storage-endpoint
S3_REGION=us-east-1
S3_BUCKET=replace-with-existing-bucket
S3_PREFIX=gunpla
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key
MAX_IMAGE_BYTES=5242880

# Admin secrets. Generate these locally; never commit real values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt$replace-with-generated-value
SESSION_SECRET=replace-with-at-least-32-random-characters

# DATABASE_URL should come from the attached NEO DB rather than being committed here.
